# Telegram Linux Admin — environment template (3.5)
#
# Copy to `.env` next to config.json (or set a path via TLA_ENV_FILE).
# The bot loads `.env` at boot; real environment variables always win.
# `.env` is gitignored — NEVER commit the filled-in file.

# --- Bot identity (required one of the two) ---
# Your bot token from @BotFather. Use the NEW token after any leak:
TLA_BOT_TOKEN=

# --- Owner / admin (recommended instead of relying on setup PIN) ---
# Your numeric Telegram user ID (send /start to the bot; it prints your ID,
# or ask @userinfobot).
TLA_ADMIN_ID=

# --- Access mode ---
# admin_only (default, fail-closed) | whitelist | open (dangerous)
TLA_ACCESS_MODE=admin_only

# --- One-time admin enrollment (optional) ---
# If set AND no admin is configured, the first user to send "/start <pin>"
# becomes the admin and the PIN is burned. Rate-limited against brute force.
TLA_SETUP_PIN=

# --- Web management API (platform 4.0) ---
# FastAPI backend + SPA. Host installs default to loopback (127.0.0.1:8080);
# production must sit behind a TLS reverse proxy (see deploy/README.md).
# TLA_WEB_ENABLED=1
# TLA_WEB_HOST=127.0.0.1
# TLA_WEB_PORT=8080
# Force Secure cookies when the auto-detection is wrong (required behind TLS):
# TLA_WEB_SECURE_COOKIES=1
# One-time token for the initial web OWNER bootstrap (remove after setup):
# TLA_SETUP_TOKEN=
# Public URL used by the Bale "Open Management App" button:
# TLA_PUBLIC_URL=https://admin.example.com
# Optional file-manager chroots for operator/read-only roles (comma separated):
# TLA_FILES_ALLOWED_ROOTS=/srv,/home

# --- Bale bot (platform 4.0, optional) ---
# Create a bot in Bale, put its token here and the adapter starts with the
# platform. Link a Bale account from the web Security Center (link code).
BALE_BOT_TOKEN=

# --- Runtime options ---
# TLA_CONFIG_FILE=config.json
# TLA_ENV_FILE=.env
# TLA_DESTINATION_POLICY=deny_public
# TLA_HEALTH_PORT=8081

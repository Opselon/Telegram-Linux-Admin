{
  "telegram_token": "YOUR_TELEGRAM_BOT_TOKEN",
  "whitelisted_users": [
    123456789
  ],
  "access_mode": "whitelist",
  "destination_policy": "deny_public",
  "allowed_destinations": [
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "servers": [
    {
      "alias": "local",
      "hostname": "localhost",
      "user": "your_user",
      "key_path": "/home/your_user/.ssh/id_rsa"
    },
    {
      "alias": "remote",
      "hostname": "your_remote_server.com",
      "user": "your_user",
      "key_path": "/home/your_user/.ssh/id_rsa"
    }
  ]
}
